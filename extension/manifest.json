
{
    "manifest_version": 3,
    "name": "YourLyrics",
    "version": "1.0.0",
    "description": "Muestra las letras sincronizadas de la música reproducida en YouTube Music.",

    "host_permissions": [
        "https://music.youtube.com/*",
        "http://127.0.0.1:8765/*"
    ],

    "content_scripts": [
        {
            "matches": [
                "https://music.youtube.com/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ],

    "background": {
        "service_worker": "background.js"
    }
}
